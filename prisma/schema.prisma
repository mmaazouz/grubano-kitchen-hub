generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Core ──────────────────────────────────────────────────────────────────────

model Operator {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String?                              // bcrypt hash — null for SSO / seed accounts
  phone     String?
  city      String?
  status    String    @default("active")   // active | pending | pending_review | suspended
  // Optional human-readable reason for a suspension / refusal — shown to the
  // partner and kept for audit. ADDITIVE + REVERSIBLE: nullable, no backfill,
  // existing rows stay valid and dropping it leaves the model intact.
  statusReason String?
  role       String     @default("restaurant")   // restaurant | franchise | creator | consumer | admin | supplier
  createdAt  DateTime   @default(now())
  // ── Partner email verification + RGPD consent (Agent 12, brique 1) ───────────
  // ADDITIVE + REVERSIBLE: every field is nullable, so existing rows (consumers,
  // operators, seed accounts) stay valid with zero backfill and dropping these
  // columns leaves the rest of the model untouched. A partner self-registers via
  // POST /api/partners/register in status 'pending' with a SHA-256-hashed,
  // single-use verification token (24h). GET /api/partners/verify-email promotes
  // the account to 'active' and stamps emailVerifiedAt. Login is refused
  // while status='pending'. consentAt records the explicit, timestamped RGPD
  // consent given at registration.
  emailVerifiedAt   DateTime?
  verifyTokenHash   String?
  verifyTokenExpiry DateTime?
  consentAt         DateTime?
  // ── Passwordless magic-link sign-in (Phase 0 auth bridge, Agent 14) ──────────
  // ADDITIVE + REVERSIBLE: both nullable, no backfill, dropping them is safe.
  // A SEPARATE pair from verifyToken* (partner email verification) so the two
  // never collide. Stores ONLY the SHA-256 of the link secret + a short expiry
  // (15 min). Single-use: cleared on a successful magic-link sign-in. Lets a
  // passwordless account (e.g. a creator) sign in by email link, ALONGSIDE the
  // existing password CredentialsProvider (which is untouched).
  magicLinkTokenHash   String?
  magicLinkTokenExpiry DateTime?
  brands       Brand[]
  accounts     Account[]
  sessions     Session[]
  // Option B (step 4): an operator can own several establishments. The UI is still
  // mono-establishment (reads restaurants[0]); multi-establishment is a later step.
  restaurants  Restaurant[]
  // Franchise (role=franchise) owns one or more points of sale. Empty for
  // non-franchise operators — the relation list is nullable by virtue of
  // being a list (Prisma returns []).
  pointsOfSale PointOfSale[]
  // ── Multi-role account (Phase 1 refonte, Agent 14) — ADDITIVE ───────────────
  // The single `role` column above is KEPT (it stays the PRIMARY role + a
  // rollback source). This relation is the full role SET. Access gating reads the
  // SET (middleware); redirects still use the primary `role`. Backfilled 1:1 from
  // `role` at migration. Reversible: drop the OperatorRole table, the model is
  // unchanged.
  operatorRoles OperatorRole[]
  // Slice 2 — B2B supply orders this operator (as a restaurateur) placed to
  // marketplace suppliers. Additive inverse relation; reversible.
  supplyOrders  SupplyOrder[]
  // ── Company identity anchor (B1.1, Agent 29) — ADDITIVE · REVERSIBLE · INERT ──
  // Future "collect once" home for BUSINESS identity at the ACCOUNT level. Today
  // company identity is siloed per-entity (SupplierProfile / LogisticsProfile,
  // keyed by email); this is the single account-level anchor the verification
  // flows (B1.3 / Phase 4) will populate. Field names mirror SupplierProfile
  // (siren / officialName) for consistency. NULLABLE, no default, NO backfill →
  // existing rows stay valid (all NULL) and dropping these columns is safe.
  // INERT in this brick: NOTHING reads these at runtime; they are written ONLY by
  // future SERVER-side KYB flows — never by user input (absent from the P5 profile
  // whitelists). `kybStatus` is named distinctly from the per-entity
  // `verificationStatus` on purpose: it is the ACCOUNT-level Know-Your-Business
  // state, not a duplicate of the entity-scoped field.
  siren         String?   // FR 9-digit business number (mirrors SupplierProfile.siren)
  officialName  String?   // legal / registered company name (mirrors SupplierProfile.officialName)
  legalForm     String?   // legal entity type — free string, no enum yet (e.g. auto_entrepreneur | sarl | sas)
  kybStatus     String?   // account-level KYB state — free string, no enum yet (e.g. none | pending | verified | rejected)
  kybVerifiedAt DateTime? // when account-level KYB was confirmed
  // ── P4.1 — Stripe Connect (Express) onboarding for the FRANCHISE payout flow
  // (TEST mode; gated by FRANCHISE_CONNECT_ENABLED). Prefixed `franchise*` because
  // Operator is multi-purpose: this is the connected account for the 'franchise'
  // role's FUTURE payouts, kept DISTINCT from any Creator account the same human
  // may also hold (per-person consolidation = later, out of scope). ADDITIVE +
  // REVERSIBLE: all nullable, NO default / NO constraint / NO backfill. NO charge /
  // payout here (= P4.3) — only tracks the connected account + onboarding state.
  // Status synced ON-DEMAND (no webhook in P4.1).
  franchiseStripeAccountId   String?    // acct_… (Express, FR)
  franchisePayoutStatus      String?    // none | pending | active | restricted (null = none)
  franchiseStripeOnboardedAt DateTime?  // first time the franchise account became 'active'
}

// ── OperatorRole (Phase 1 refonte) — one row per (operator, role) ─────────────
// The role SET behind the multi-role account model. @@unique makes the backfill
// idempotent (one row per role per operator). Cascade-deletes with the operator.
model OperatorRole {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  role       String   // restaurant | franchise | creator | consumer | admin | supplier
  createdAt  DateTime @default(now())

  @@unique([operatorId, role])
  @@index([operatorId])
}

model Brand {
  id         String         @id @default(cuid())
  operatorId String
  operator   Operator       @relation(fields: [operatorId], references: [id])
  // ── Establishment link (Option B, additive step 1) ──────────────────────────
  // ADDITIVE + REVERSIBLE: a Brand belongs to one Restaurant (establishment).
  // Nullable so every existing row stays valid with no backfill, and dropping the
  // column again is non-destructive. Backfill (step 2), read switch (step 3) and
  // the Operator→restaurants cardinality flip (step 4) come in later commits.
  // Nothing reads restaurantId yet, so runtime behaviour is unchanged.
  restaurantId String?
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id])
  name       String
  emoji      String         @default("🍴")
  platform   String         @default("ubereats")
  status     String         @default("active")
  // ── Franchise (brique 2A) ───────────────────────────────────────────────────
  // ADDITIVE + REVERSIBLE: a Brand can be opened to franchising and reused as a
  // "franchisable brand". Every field below is optional or has a safe default,
  // so existing Brand rows stay valid with no backfill. Dropping these columns
  // again is non-destructive to the rest of the model.
  openToFranchise   Boolean @default(false)  // is this brand open to franchising
  royaltyPct        Float?                    // royalty % of revenue paid to the franchisor (e.g. 0.06)
  setupFee          Float?                    // one-off installation fee in €
  franchiseZones    Json    @default("[]")    // allowed cities/zones (array of strings)
  tagline           String?                   // short pitch shown on the discovery page
  cuisineType       String?                   // e.g. "Italien", "Asiatique"
  avgMonthlyRevenue Float?                     // indicative showcase revenue
  franchiseStatus   String  @default("none")  // none | open | full (drives the "Complet" badge)
  createdAt  DateTime       @default(now())
  orders     LoyaltyOrder[]
  menuItems  MenuItem[]
  promotions Promotion[]
  stockItems StockItem[]
  // Inverse side of PointOfSale.brand_ref (brique 2A).
  pointsOfSale PointOfSale[]
  // Inverse side of DishAdoption.brand (brique 3A) — creator recipes this brand adopted.
  dishAdoptions DishAdoption[]
  // Inverse side of AdoptionWaitlist.brand (levier 3A) — city-exclusivity queue.
  waitlist      AdoptionWaitlist[]
  // Inverse side of Category.brand — this brand's CUSTOM menu categories.
  categories    Category[]

  @@index([restaurantId])
}

// ── Custom menu categories (additive) ─────────────────────────────────────────
// ADDITIVE + REVERSIBLE: a brand's CUSTOM menu categories. The 4 built-in defaults
// (Entrées / Plats / Desserts / Boissons) are NOT stored here — they are front-end
// constants, always present and non-deletable. Only the operator's own extra
// categories live in this table. MenuItem.category stays a free-text column (the
// category NAME), so existing dishes are untouched and there is no mandatory FK —
// this table just remembers/edits the custom list per brand. Dropping it is
// non-destructive. onDelete: Cascade so deleting a brand removes its categories
// (keeps the establishment hard-delete orphan-free with no extra step).
model Category {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  // Unique per brand (no duplicate names). This composite also indexes brandId
  // via its leftmost prefix, so per-brand lookups stay fast with no extra index.
  @@unique([brandId, name])
}

// ── Loyalty ───────────────────────────────────────────────────────────────────

model LoyaltyCustomer {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  pointsBalance Int            @default(10)
  tier          String         @default("bronze")
  referralCode  String         @unique @default(cuid())
  referredBy    String?
  createdAt     DateTime       @default(now())
  orders        LoyaltyOrder[]
  rewards       Reward[]
}

// ── Loyalty ledger (chantier fidélité L1) ─────────────────────────────────────
// Points are a currency → every movement is TRACED here (like DishSale /
// ReferralOrder), pointsBalance stays the cache. Signed `points`: +earned (at a
// delivered order), −spent (redeemed at a confirmed payment), +re-credited (on a
// refund). Idempotence is enforced per [orderId, type] by the callers. Additive.
model LoyaltyTransaction {
  id         String   @id @default(cuid())
  customerId String   // LoyaltyCustomer.id
  orderId    String?  // the consumer Order this movement relates to (null = manual/other)
  type       String   // earn | redeem | refund
  points     Int      // signed: +earned / −spent / +re-credited
  createdAt  DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
}

model LoyaltyOrder {
  id              String          @id @default(cuid())
  customerId      String
  customer        LoyaltyCustomer @relation(fields: [customerId], references: [id])
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id])
  uberOrderNumber String          @unique
  amount          Float
  pointsEarned    Int
  validatedAt     DateTime        @default(now())
}

model Reward {
  id         String          @id @default(cuid())
  customerId String
  customer   LoyaltyCustomer @relation(fields: [customerId], references: [id])
  type       String
  promoCode  String          @unique @default(cuid())
  redeemed   Boolean         @default(false)
  createdAt  DateTime        @default(now())
}

// ── Menu ──────────────────────────────────────────────────────────────────────

model MenuItem {
  id            String   @id @default(cuid())
  brandId       String
  brand         Brand    @relation(fields: [brandId], references: [id])
  name          String
  description   String?  @db.Text
  price         Float
  comparePrice  Float?
  category      String
  calories      Int?
  allergens     Json     @default("[]")
  labels        Json     @default("[]")
  photos        Json     @default("[]")
  options       Json     @default("[]")
  available     Boolean  @default(true)
  isPopular     Boolean  @default(false)
  prepTime      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  // Inverse side of DishAdoption.menuItem (brique 3A) — the menu entries created
  // when a brand adopted a creator recipe.
  dishAdoptions DishAdoption[]
}

model Promotion {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  name       String
  type       String   // percent | fixed | second_item | threshold_reward
  discount   Float
  conditions Json     @default("{}")
  startDate  DateTime
  endDate    DateTime
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  // ── Promo V2 Slice 2 (CreatorCampaign opt-in, ADDITIVE + nullable) ──────────
  // Set when this Promotion was created by a restaurateur OPTING IN to a chef's
  // campaign. The promo is a STANDARD resto-financed Promotion (same engine,
  // same guards) — campaignId only LINKS it back for display. Nullable so every
  // existing promo stays valid and the column is column-tolerant before db push.
  campaignId String?
  campaign   CreatorCampaign? @relation(fields: [campaignId], references: [id])

  @@index([campaignId])
}

// ── Chef demand-driver campaign (Promo V2 Slice 2) ────────────────────────────
// A chef PROPOSES a discount on an ADOPTED recipe (a suggested %, a message, a
// window). The chef NEVER finances it. Adopter restaurants OPT IN and finance it
// via a standard resto-financed Promotion (one per resto, linked by campaignId).
// ADDITIVE: a brand-new table — pre-db-push, every campaign read is wrapped
// tolerant (→ no campaigns) so existing flows are untouched until the push.
model CreatorCampaign {
  id                   String      @id @default(cuid())
  creatorDishId        String
  creatorDish          CreatorDish @relation(fields: [creatorDishId], references: [id])
  creatorId            String
  creator              Creator     @relation(fields: [creatorId], references: [id])
  suggestedDiscountPct Int         // 1..90 — the chef's SUGGESTION (the resto adjusts)
  message              String      @db.Text
  startDate            DateTime
  endDate              DateTime
  status               String      @default("active") // draft | active | ended
  createdAt            DateTime    @default(now())
  promotions           Promotion[] // the resto opt-in promos linked to this campaign

  @@index([creatorDishId])
  @@index([creatorId])
  @@index([status])
}

// ── Stocks ────────────────────────────────────────────────────────────────────

model StockItem {
  id           String    @id @default(cuid())
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id])
  name         String
  quantity     Float     @default(0)
  unit         String    @default("kg")
  minThreshold Float     @default(0)
  dlc          DateTime?
  lastUpdated  DateTime  @default(now()) @updatedAt
}

// ── Suppliers ─────────────────────────────────────────────────────────────────

model Supplier {
  id        String            @id @default(cuid())
  name      String
  specialty String?
  zone      String?
  leadTime  String            @default("24h")
  minOrder  Float             @default(0)
  rating    Float             @default(5.0)
  apiEnabled Boolean          @default(false)
  phone     String?
  email     String?
  createdAt DateTime          @default(now())
  products  SupplierProduct[]
  orders    SupplierOrder[]
}

model SupplierProduct {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  name       String
  unit       String   @default("kg")
  price      Float
  stock      String   @default("in") // in | low | out
  updatedAt  DateTime @updatedAt
}

model SupplierOrder {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  items      Json
  total      Float
  status     String   @default("pending") // pending | sent | confirmed | delivered
  sentAt     DateTime @default(now())
  deliveredAt DateTime?
}

// ── Tables & reservations ─────────────────────────────────────────────────────

model RestaurantTable {
  id           String        @id @default(cuid())
  // ── Establishment link (Chantier 2, additive step 1) ────────────────────────
  // ADDITIVE + REVERSIBLE: a table belongs to ONE establishment (Restaurant), so
  // /tables can be scoped per establishment — dark kitchens simply have 0 tables.
  // Nullable so every existing row stays valid with no backfill, and dropping the
  // column again is non-destructive. Backfill (step 2) sets existing tables to the
  // main establishment; the scoped reads/writes (step 3) then rely on it. Same
  // shape as Brand.restaurantId.
  restaurantId String?
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id])
  name         String
  seats        Int
  x            Float         @default(50)
  y            Float         @default(50)
  active       Boolean       @default(true)
  reservations Reservation[]
  // Inverse side of TableTicket.restaurantTable (Addition brique 1).
  tickets      TableTicket[]

  @@index([restaurantId])
}

model Reservation {
  id           String          @id @default(cuid())
  tableId      String
  table        RestaurantTable @relation(fields: [tableId], references: [id])
  // ── Establishment link (Chantier 2, additive step 1) ────────────────────────
  // ADDITIVE + REVERSIBLE: a reservation is made AT one establishment. It COULD be
  // derived from the table (table.restaurantId), but a DIRECT, indexed field lets
  // us scope reservations with a simple `where { restaurantId, date }` (no relation
  // join) and FREEZES the establishment at booking time, so the row stays correct
  // even if the table is later reassigned or removed. Same denormalised pattern as
  // Order.restaurantId. Nullable until backfilled.
  restaurantId String?
  restaurant   Restaurant?     @relation(fields: [restaurantId], references: [id])
  // ── Account link (Sécurité addition, additive) ──────────────────────────────
  // The connected consumer's account id (= session.user.id = Operator.id) when the
  // reservation was made while logged in; null for anonymous / walk-in / legacy
  // rows. Gates the APP/ACCOUNT pay+order channel (only the linked client, once
  // status='arrived'). The QR walk-in channel ignores this — it stays open. Plain
  // indexed String (no strict FK — the NextAuth identity model is ambiguous).
  userId       String?
  customerName String
  phone        String?
  email        String?
  guests       Int
  date         DateTime
  endTime      DateTime
  type         String          @default("standard") // quick | standard | full
  status       String          @default("confirmed") // confirmed | arrived | overrun | cancelled | noshow
  allergies    Json            @default("[]")
  preOrder     Json            @default("[]")
  depositAmount Float          @default(0)
  depositPaid  Boolean         @default(false)
  noShowPenalty Float          @default(0)
  // ── Stripe deposit hold (Paiement V1, additive — TEST mode) ─────────────────
  // ADDITIVE + REVERSIBLE: a TheFork-style guarantee held by a manual-capture
  // Stripe PaymentIntent (pre-authorisation). On arrival → cancel (nothing
  // charged); on no-show → capture the penalty. depositPaid is KEPT for
  // back-compat; depositStatus is the finer lifecycle. All nullable / defaulted,
  // so existing rows stay valid with no backfill.
  stripePaymentIntentId String?              // the PaymentIntent id (pi_...)
  depositStatus String          @default("none") // none | authorized | captured | released
  depositCurrency String        @default("eur")
  // ── Cancellation trace (Chantier horaires, additive) ────────────────────────
  // WHY a reservation was cancelled. 'closure' = auto-cancelled because the
  // restaurant declared an exceptional closure over its slot (empreinte released,
  // nothing charged). Nullable → existing rows untouched; manual cancels may
  // leave it null.
  cancelReason String?
  // WHO cancelled — 'consumer' (self-cancel within the window via
  // POST /api/reservations/[id]/cancel) | 'operator' (dashboard PATCH).
  // Nullable → existing rows untouched (closure cancels may leave it null).
  cancelledBy  String?
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())

  @@index([userId])
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  user              Operator @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         Operator @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Email audit log ───────────────────────────────────────────────────────────

model EmailLog {
  id           String   @id @default(cuid())
  recipient    String
  subject      String
  trigger      String
  status       String   @default("sent")
  claudeTokens Int?
  sentAt       DateTime @default(now())
}

// ── Creator economy ───────────────────────────────────────────────────────────

model Creator {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  bio           String?       @db.Text
  instagram     String?
  tiktok        String?
  youtube       String?
  followers     Int           @default(0)
  verified      Boolean       @default(false)
  totalEarnings Float         @default(0)
  // ── Role split (Mission 2 Creator Studio, ADDITIVE) ─────────────────────────
  // Two DISTINCT and CUMULABLE roles (pivot 12 juin):
  //   isChef       → royalties model (2 % of adopted-recipe sales, /chef page)
  //   isInfluencer → affiliation model (/ref link, 30 % of Grubano commission)
  // NOT NULL DEFAULT true → every existing creator keeps BOTH roles at deploy
  // (zero regression by decision). The separation is expressed by CHOICE
  // (wizard + self-service toggles). No referralCode is ever destroyed —
  // masked/disabled by the flag only.
  isChef        Boolean       @default(true)
  isInfluencer  Boolean       @default(true)
  // Inverse side of CreatorCampaign.creator (Promo V2 Slice 2).
  campaigns     CreatorCampaign[]
  // Referral programme — nullable so existing creators keep working until
  // they are granted a code / slug from the back office.
  referralCode     String?    @unique           // e.g. "MARCO20"
  referralLinkSlug String?    @unique           // used in /r/{slug}
  referrals        Referral[]
  dishes        CreatorDish[]
  // ── P4.1 — Stripe Connect (Express) onboarding for payouts (TEST mode; gated by
  // CREATOR_CONNECT_ENABLED). ADDITIVE + REVERSIBLE: all nullable, NO default / NO
  // constraint / NO backfill. Names mirror SupplierProfile. NO charge/payout here
  // (= P4.3) — only tracks the connected account + onboarding state. Status is
  // synced ON-DEMAND (no webhook in P4.1).
  stripeAccountId   String?    // acct_… (Express, FR)
  payoutStatus      String?    // none | pending | active | restricted (null = none)
  stripeOnboardedAt DateTime?  // first time the account became 'active'
  createdAt     DateTime      @default(now())
}

model CreatorDish {
  id             String   @id @default(cuid())
  creatorId      String
  creator        Creator  @relation(fields: [creatorId], references: [id])
  name           String
  description    String   @db.Text
  photo          String?
  ingredients    Json
  suggestedPrice Float
  cuisineType    String
  status         String   @default("pending")   // pending | approved | rejected
  adoptedBy      Json     @default("[]")
  commission     Float    @default(0.04)
  totalSales     Int      @default(0)
  // ── Fiche recette de chef (Mission 6, ADDITIVE) ─────────────────────────────
  // The LICENSED ASSET: technical sheet (quantified ingredients, ordered steps,
  // timings, allergens, plating, story, cost) — shape = lib/dish-sheet.DishSheet.
  // NULLABLE: every existing row stays valid (legacy tolerated, D2) and all the
  // code survives the column being absent pre-db-push (tolerant read → null).
  // NEVER served publicly — only to restos with a DishAdoption of the recipe,
  // the creator, or an admin (D1, enforced by /api/dishes/[id]/sheet).
  sheet          Json?
  createdAt      DateTime @default(now())
  // Inverse side of DishAdoption.creatorDish (brique 3A) — restaurateurs who
  // adopted this recipe. KEEP adoptedBy + totalSales above for back-compat.
  adoptions      DishAdoption[]
  // Inverse side of AdoptionWaitlist.creatorDish (levier 3A) — per-city queue.
  waitlist       AdoptionWaitlist[]
  // Inverse side of CreatorCampaign.creatorDish (Promo V2 Slice 2).
  campaigns      CreatorCampaign[]
}

// ── Franchise applications ────────────────────────────────────────────────────

model FranchiseApplication {
  id          String   @id @default(cuid())
  operatorId  String?
  name        String
  city        String
  phone       String
  email       String
  siret       String?
  rib         String?
  hasKitchen  Boolean  @default(false)
  brandName   String
  motivation  String   @db.Text
  status      String   @default("pending")  // pending | approved | rejected
  createdAt   DateTime @default(now())
}

model CreatorApplication {
  id           String   @id @default(cuid())
  name         String
  email        String
  bio          String   @db.Text
  instagram    String?
  tiktok       String?
  youtube      String?
  followers    Int      @default(0)
  dishConcepts Json     @default("[]")
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

// ── FranchiseeApplication (B7, Agent 48) — a restaurateur applies to JOIN a brand ──
// ADDITIVE + REVERSIBLE: a brand-new table; no existing row/column is touched, no
// backfill, and dropping it leaves the rest of the schema intact.
// DISTINCT from FranchiseApplication above (which is a candidacy to BECOME a franchisor,
// admin-approved, grants the 'franchise' role). HERE an independent restaurateur asks to
// attach ONE of THEIR OWN restaurants (restaurantId, owned by applicantOperatorId) to an
// OPEN Brand (brandId). The BRAND OWNER (the franchisor) approves → a PointOfSale is
// created (franchiseId = the franchisor, brandId) and the restaurant is linked
// (Restaurant.pointOfSaleId, strict 1:1). The cross-operator link (applicant's resto ↔
// franchisor's POS) is created ONLY by this double accord: the applicant POSTED + the
// franchisor APPROVED. Scalar refs only (no @relation — mirrors Payout / FranchiseRoyalty)
// to keep the surface minimal. @@unique([restaurantId, brandId]) = ONE application row per
// (restaurant, brand): re-applying after a rejection flips the SAME row back to pending,
// so there can never be two live candidacies for the same pair.
model FranchiseeApplication {
  id                  String    @id @default(cuid())
  restaurantId        String              // the applicant's restaurant to enrol
  brandId             String              // the open brand being joined
  applicantOperatorId String              // = Restaurant.operatorId (the candidate)
  status              String    @default("pending") // pending | approved | rejected
  message             String?   @db.Text  // optional note to the franchisor
  pointOfSaleId       String?             // the POS created on approval (the link result)
  decidedAt           DateTime?           // when approved / rejected
  createdAt           DateTime  @default(now())

  @@unique([restaurantId, brandId])       // one candidacy per (restaurant, brand)
  @@index([brandId, status])
  @@index([applicantOperatorId])
  @@index([restaurantId])
}

// ── SupplierProfile (B2B supply marketplace — Slice 0 foundation, Agent 14) ───
// ADDITIVE + REVERSIBLE: a brand-new model; no existing row is touched and
// dropping the table leaves the rest of the schema intact. DISTINCT from the
// existing `Supplier` (an operator's PRIVATE supplier-directory entry, above):
// this is the marketplace SUPPLIER's own business profile (the supplier-as-user).
// Linked to the Operator LOGIN account by SHARED EMAIL (like Creator — no FK): the
// passwordless Operator whose role / SET includes 'supplier' is provisioned by
// lib/supplier-account.ensureSupplierOperator. BUSINESS PROFILE only — NO
// catalogue / pricing here (those are Slice 1+). MySQL has no native array type →
// multi-value fields are Json @default("[]").
model SupplierProfile {
  id                String   @id @default(cuid())
  email             String   @unique          // shared-email link to the Operator account
  companyName       String                    // commercial / trading name
  contactName       String
  phone             String?
  city              String?
  // Supply terms (profile only — Slice 0; NO catalogue/prices yet)
  categories        Json     @default("[]")    // string[] — fresh|meat|fish|dairy|drinks|grocery|packaging
  deliveryZones     Json     @default("[]")    // string[] — cities / postal areas served
  minimumOrderCents Int      @default(0)       // minimum order (cents) — displayed via lib/format-money
  leadTimeDays      Int      @default(1)       // delivery lead time (days)
  paymentTerms      String?  @db.Text          // free text for now (Slice 5 formalizes the economics)
  status            String   @default("pending")   // pending | active | suspended | rejected (business state)
  // Auto-onboarding LLM vetting (Agent 14): the verdict that DECIDED `status` at
  // registration. ADDITIVE + REVERSIBLE. Gates VISIBILITY/catalogue ONLY — never
  // money (Stripe Connect KYB stays the independent hard gate for payouts).
  vettingVerdict    String?                          // legit | doubt | bad (null = legacy / not auto-vetted)
  vettingReason     String?  @db.Text                // short FR reason from the vetting/verification step
  vettingAt         DateTime?                         // when the auto-vetting ran
  // Automatic BUSINESS-IDENTITY verification (Agent 14): the SIREN/SIRET is checked
  // against the free official French registry (recherche-entreprises.api.gouv.fr),
  // the LLM only fuzzy-matches the declared vs official name. ADDITIVE + REVERSIBLE.
  // Gates VISIBILITY/activation ONLY — money stays gated by Stripe Connect KYB.
  siren             String?                          // 9-digit SIREN (derived from a SIREN or SIRET input)
  officialName      String?                          // dénomination from the official registry (when verified)
  verificationStatus String?                         // verified | rejected | review (null = legacy / not auto-verified)
  verifiedAt        DateTime?                         // when the registry verification passed
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // Slice 5b — Stripe Connect (Express) onboarding for payouts (TEST mode; gated by
  // SUPPLIER_CONNECT_ENABLED). ADDITIVE + REVERSIBLE. NO charge/payout here (= 5c) —
  // this only tracks the connected account + KYB onboarding state. Mirrors the B2C
  // Restaurant.stripeAccountId pattern but on a SEPARATE B2B path.
  stripeAccountId   String?  @unique             // acct_… (Express, FR)
  payoutStatus      String   @default("none")    // none | pending | active | restricted
  stripeOnboardedAt DateTime?                     // first time the account became 'active'
  // Slice 1 — the supplier's own product catalogue (additive inverse relation).
  catalogItems      SupplierCatalogItem[]
  // Slice 2 — incoming B2B supply orders placed BY restaurateurs to this supplier.
  supplyOrders      SupplyOrder[]
}

// ── LogisticsProfile (courier / delivery partner onboarding — Slice 1, Agent 15) ─
// The delivery-partner analogue of SupplierProfile, calqued on it for consistency.
// A logistics partner self-registers (independent / company), the SIREN is checked
// against the free official French registry (reuses lib/business-verification,
// UNMODIFIED), and on success a passwordless Operator gains the 'logistics' role
// (multi-role cumul). PROFILE ONLY — NO payment / Stripe / KYB here (later slice,
// exactly like the supplier path). ADDITIVE + REVERSIBLE: a brand-new model linked
// to the Operator only by shared `email` (no FK), so dropping it leaves every
// existing table untouched.
model LogisticsProfile {
  id                 String   @id @default(cuid())
  email              String   @unique          // shared-email link to the Operator account (= contact email)
  partnerType        String   @default("independent") // independent | company
  contactName        String                    // human contact / display name
  contactPhone       String?
  // Operations (profile only — Slice 1; NO mission dispatch / pricing yet)
  missionTypes       Json     @default("[]")    // string[] — repas|produits_fournisseurs|b2b|froid
  vehicleTypes       Json     @default("[]")    // string[] — velo|scooter|voiture|camionnette|frigorifique
  zones              Json     @default("[]")    // string[] — cities / postal codes served
  status             String   @default("pending")   // pending | active | suspended | rejected (business state)
  // Automatic BUSINESS-IDENTITY verification (reuses lib/business-verification). The
  // SIREN/SIRET is checked against the official registry; gating is NAME-TOLERANT —
  // the declared contact name is a display name, never a rejection criterion (a
  // courier whose declared name differs from the registry is NOT rejected). Gates
  // VISIBILITY/activation ONLY — money stays out of this slice entirely.
  siren              String?                          // 9-digit SIREN (derived from a SIREN or SIRET input)
  officialName       String?                          // dénomination from the official registry (when verified)
  verificationStatus String?                          // verified | rejected | review (null = legacy / not auto-verified)
  verifiedAt         DateTime?                         // when the registry verification passed
  vettingReason      String?  @db.Text                // short FR reason from the verification step
  vettingAt          DateTime?                         // when the auto-verification ran
  // ── P4.1 — Stripe Connect (Express) onboarding for payouts (TEST mode; gated by
  // LOGISTICS_CONNECT_ENABLED). ADDITIVE + REVERSIBLE: all nullable, NO default / NO
  // constraint / NO backfill. Names mirror SupplierProfile. NO charge/payout here
  // (= P4.3) — only tracks the connected account + onboarding state. Status synced
  // ON-DEMAND (no webhook in P4.1).
  stripeAccountId    String?                           // acct_… (Express, FR)
  payoutStatus       String?                           // none | pending | active | restricted (null = none)
  stripeOnboardedAt  DateTime?                         // first time the account became 'active'
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ── SupplierCatalogItem (B2B supply marketplace — Slice 1 catalogue, Agent 14) ─
// ADDITIVE + REVERSIBLE: a brand-new model; dropping it leaves the schema intact.
// DISTINCT from the operator's PRIVATE directory `SupplierProduct` (above): this is
// the marketplace supplier's OWN catalogue (an SKU), scoped by FK to its
// SupplierProfile. A supplier manages ONLY its own items. Price is stored in
// integer CENTS (displayed via lib/format-money) — never euros (no float rounding).
// NO order / take-rate here (Slices 2 & 5). Allergens reuse the INCO ids
// (lib/dish-sheet.INCO_ALLERGENS) and are OPTIONAL. MySQL has no native array type
// → multi-value fields are Json @default("[]").
model SupplierCatalogItem {
  id                String          @id @default(cuid())
  supplierProfileId String
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  name              String
  description       String?         @db.Text
  category          String          @default("autre")   // free-text family (viande, crémerie…)
  priceCents        Int             @default(0)          // unit price in CENTS
  unit              String          @default("piece")    // kg | g | L | cl | piece | box | pack
  packSize          String?                              // conditioning / lot size, e.g. "carton de 6"
  available         Boolean         @default(true)       // false = out of stock
  allergens         Json            @default("[]")       // AllergenChoice[] (INCO ids) — optional
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([supplierProfileId, name])
  @@index([supplierProfileId])
  @@index([category])
  // Slice 2 — order lines snapshotting this item (soft audit FK; SetNull on delete).
  orderLines        SupplyOrderLine[]
}

// ── SupplyOrder (B2B supply marketplace — Slice 2 order, Agent 14) ────────────
// ADDITIVE + REVERSIBLE. The B2B PURCHASE ORDER a restaurateur places to a
// marketplace supplier. DISTINCT from the operator's PRIVATE directory
// `SupplierOrder` (above) AND from the B2C `Order` — a fully separate pipeline:
// NO loyalty / promo / referral / take-rate (Slice 5). Total is the integer-CENTS
// snapshot sum of its lines at order time. Buyer = Operator (resto, session-scoped);
// seller = SupplierProfile. Status flow beyond "placed" is Slice 3.
model SupplyOrder {
  id                String          @id @default(cuid())
  operatorId        String          // buyer — the restaurateur (from the session)
  operator          Operator        @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  supplierProfileId String          // seller — the marketplace supplier
  // Restrict on delete: a supplier with order history can't be removed (preserves
  // the orders). supplierProfileId is required, so SetNull is not applicable here.
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Restrict)
  status            String          @default("placed")   // placed (Slice 3 adds confirm/prepare/deliver)
  totalCents        Int             @default(0)          // snapshot sum of lines at order time
  notes             String?         @db.Text             // optional message to the supplier
  desiredDate       DateTime?                            // requested delivery date (optional)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lines             SupplyOrderLine[]
  // ── Payment (B2B Slice 5c — Stripe Checkout destination charge, TEST; gated) ──
  // ADDITIVE + REVERSIBLE: all nullable / defaulted. The resto pays `chargedCents`
  // (= computeSupplyEconomics.restoPaysCents), the supplier nets supplierPayoutCents,
  // Grubano keeps grubanoMarginCents (the application_fee) — ALL from lib/supply-pricing.
  // No money moves until 5c gating passes; status flips on the B2B webhook.
  paymentStatus           String   @default("unpaid")  // unpaid | pending | paid | failed
  stripeCheckoutSessionId String?                       // cs_… (the Checkout session)
  stripePaymentIntentId   String?                       // pi_… (set on payment success)
  chargedCents            Int      @default(0)          // restoPaysCents at pay time (5a)
  supplierPayoutCents     Int      @default(0)          // supplierPayoutCents (5a)
  grubanoMarginCents      Int      @default(0)          // application_fee (5a)
  paidAt                  DateTime?                      // when the payment succeeded

  @@index([operatorId])
  @@index([supplierProfileId])
}

// ── SupplyOrderLine (B2B order line — Slice 2, Agent 14) ──────────────────────
// IMMUTABLE snapshot of a catalogue item AT ORDER TIME (name, unit, unit price in
// CENTS) so the order history is preserved even if the supplier later edits or
// deletes the catalogue item. The catalogItem FK is a SOFT audit link (nullable,
// SetNull on delete) — never re-read for pricing.
model SupplyOrderLine {
  id              String   @id @default(cuid())
  supplyOrderId   String
  supplyOrder     SupplyOrder @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  catalogItemId   String?                              // soft audit FK (SetNull on item delete)
  catalogItem     SupplierCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  nameSnapshot    String                               // catalogue item name at order time
  unitSnapshot    String                               // catalogue item unit at order time
  quantity        Int      @default(1)
  unitPriceCents  Int      @default(0)                 // price snapshot (cents)
  lineTotalCents  Int      @default(0)                 // quantity × unitPriceCents
  createdAt       DateTime @default(now())

  @@index([supplyOrderId])
  @@index([catalogItemId])
}

// ── Consumer app ──────────────────────────────────────────────────────────────

model Restaurant {
  id           String   @id @default(cuid())
  // Option B (step 4): operatorId is NO LONGER unique — an operator can have
  // several establishments. Dropping this unique index is non-destructive on the
  // data. Indexed (not unique) so per-operator lookups stay fast.
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])
  name         String
  description  String?  @db.Text
  coverPhoto   String?
  logo         String?
  // MySQL has no native array type → store as JSON array of strings
  cuisine      Json     @default("[]")
  rating       Float    @default(0)
  reviewCount  Int      @default(0)
  deliveryTime Int      @default(30)
  minOrder     Float    @default(0)
  deliveryFee  Float    @default(1.99)
  city         String
  address      String
  lat          Float?
  lng          Float?
  isActive     Boolean  @default(true)
  // ── Soft delete (Suppression etablissement, additive) ───────────────────────
  // ADDITIVE + REVERSIBLE: when an establishment WITH order history is "deleted"
  // it is ARCHIVED (archivedAt set) instead of hard-deleted, so the sales history
  // is preserved. A truly empty establishment (0 orders) is hard-deleted instead.
  // Nullable → every existing row stays valid with no backfill; dropping the
  // column is non-destructive. ALL operator/consumer listings filter archivedAt
  // = null, so an archived establishment never reappears in the UI or aggregates.
  archivedAt   DateTime?
  // ── Establishment lifecycle (B1.1, Agent 29) — ADDITIVE · REVERSIBLE · INERT ──
  // Prepares SEC2 / B2.4 (admin approval lifecycle). NULLABLE, no default, NO
  // backfill → existing rows stay valid (NULL) and dropping is safe. INERT here:
  // NOTHING reads these at runtime. The publication / visibility barrier remains
  // isActive ONLY (SEC1, admin-gated) — `status` does NOT gate visibility. B2.4
  // will define the lifecycle values + stamp approvedAt on admin approval.
  status       String?   // establishment lifecycle state — free string, no enum yet (set by B2.4)
  approvedAt   DateTime? // when an admin approved / published this establishment (B2.4)
  // ── Fulfillment settings (operator-controlled) ──
  // Booleans toggle which fulfillment channels this restaurant offers.
  // All defaults preserve current behaviour: delivery on, pickup/reservation off.
  deliveryEnabled    Boolean @default(true)
  pickupEnabled      Boolean @default(false)
  reservationEnabled Boolean @default(false)
  deliveryRadius     Int     @default(5)    // km
  pickupPrepTime     Int     @default(15)   // minutes
  deliveryPrepTime   Int     @default(30)   // minutes
  // ── Reservation default duration (Finitions Tables, additive) ───────────────
  // ADDITIVE + non-destructive: how long a table is held by default, in minutes.
  // NOT NULL @default(60) → `db push` (ADD COLUMN ... NOT NULL DEFAULT 60)
  // backfills every existing row to 60. A reservation can still override it; the
  // POST /api/reservations uses sent duration → this establishment default → 60.
  defaultReservationDurationMin Int @default(60)
  // ── Reservation deposit empreinte amount (Finitions empreinte, additive) ─────
  // ADDITIVE + non-destructive: the guarantee deposit (empreinte) charged per
  // reservation for THIS establishment, in EUR. NOT NULL @default(10) → `db push`
  // (ADD COLUMN ... NOT NULL DEFAULT 10) backfills every existing row to 10.
  // /api/reservations/public reads this to set the reservation's depositAmount
  // (was a hardcoded 10). Mohammed's decision: ONE configurable amount per resto,
  // and the no-show penalty = 100 % of it (no separate penalty field). Reversible.
  defaultDepositAmount Float @default(10)
  // ── Consumer cancellation window (Annulation client, additive) ───────────────
  // ADDITIVE + non-destructive: how long BEFORE the reservation start the guest
  // can self-cancel online, in hours (A0 decision: « annulation libre jusqu'à
  // 2h avant, paramétrable »). NOT NULL @default(2) → `db push` backfills every
  // existing row to 2. No settings UI yet — per-resto knob reserved for later.
  cancellationWindowHours Int @default(2)
  // ── Stripe Connect — rail financier A1 (additive, TEST mode) ────────────────
  // ADDITIVE + REVERSIBLE: the establishment's Stripe Express connected account
  // (KYC onboarding). All nullable → existing rows stay valid, no backfill. A
  // restaurant WITHOUT an active connected account keeps today's exact behaviour
  // (payments stay on the platform account — routing is A2, not wired yet).
  stripeAccountId     String?   @unique  // acct_... (Express, country FR)
  stripeAccountStatus String?            // pending | active | restricted
  stripeOnboardedAt   DateTime?          // first time the account became 'active'
  // ── Commission overrides — WIRED (read by lib/commission.resolveCommissionRate) ─
  // Per-establishment override of the platform defaults (A0 decisions: 5 %
  // dine-in/table, 8 % pickup, 12 % delivery — Stripe fees included). null =
  // platform default applies. commissionFreeUntil = bounded founders offer
  // (0 % until this date). These fields ARE read & applied at checkout (A2/C1):
  // lib/commission.resolveCommissionRate + computeApplicationFee, used by the
  // orders/tickets/reservations pay routes + finance/summary. (Corrected by Agent
  // 37: the previous "NOT USED YET" note was stale.)
  commissionRateDineIn   Float?
  commissionRatePickup   Float?
  commissionRateDelivery Float?
  commissionFreeUntil    DateTime?
  pickupAddress      String?
  pickupInstructions String? @db.Text
  // ── Opening hours (Option B, additive step 1) ───────────────────────────────
  // ADDITIVE + REVERSIBLE: the establishment's opening hours, shared by all its
  // brands (same physical kitchen). Nullable JSON — no @default to keep the MySQL
  // push trivial; the application default is handled later (UI step / brique 4B).
  // Nothing reads this field yet, so runtime behaviour is unchanged.
  openingHours Json?
  // ── Franchise link (B2, additive) — Restaurant ↔ PointOfSale 1:1 ─────────────
  // ADDITIVE + REVERSIBLE: a FRANCHISED restaurant maps to exactly ONE PointOfSale
  // (the franchisor's tracked location). Nullable → existing rows stay valid, NO
  // backfill; @unique → a POS is referenced by AT MOST ONE restaurant (and a
  // restaurant holds AT MOST ONE pointOfSaleId), i.e. a strict 1:1. WRITTEN only by
  // the franchisor POS CRUD (/api/franchise/pos, owner-scoped). INERT until the
  // order-tagging brick (B5) reads it — nothing reads it yet, so runtime behaviour
  // (orders, payment, my-dashboard, royalties) is BYTE-IDENTICAL.
  pointOfSaleId String?      @unique
  pointOfSale   PointOfSale? @relation("RestaurantPointOfSale", fields: [pointOfSaleId], references: [id])
  createdAt    DateTime @default(now())
  orders       Order[]
  // Inverse side of Brand.restaurant (Option B, additive step 1) — the brands
  // (concepts) served from this establishment. Zero extra column.
  brands       Brand[]
  // Inverse side of RestaurantTable.restaurant / Reservation.restaurant
  // (Chantier 2, additive step 1) — the dining room of this establishment. Zero
  // extra column on Restaurant.
  tables       RestaurantTable[]
  reservations Reservation[]
  // Inverse side of TableTicket.restaurant (Addition brique 1) — the table bills.
  tickets      TableTicket[]
  // Inverse side of OpeningHour / ClosureException (Chantier horaires étape 1).
  weeklyHours  OpeningHour[]
  closures     ClosureException[]

  // Option B (step 4): operatorId is no longer unique; keep a plain index so the
  // frequent findFirst/findMany({ where: { operatorId } }) lookups stay fast.
  @@index([operatorId])
}

// ── Opening hours (Chantier horaires étape 1, additive) ───────────────────────
// ONE ROW PER RANGE: a weekday can hold several service ranges (midi 12:00-14:30
// + soir 19:00-22:30); ZERO rows for a weekday = closed that day. KEY RULE
// (T1.Q3): an establishment with ZERO OpeningHour rows is NOT CONFIGURED → no
// restriction anywhere (current behaviour); once at least one row exists the
// hours RULE (availability, public bookings, delivery/pickup orders). Times are
// LOCAL establishment time (Europe/Paris — France first), "HH:mm".
//   • closeTime < openTime → the range ends the NEXT day (19:00→01:00 service
//     after midnight, T5); "24:00" is accepted as a close for a 00:00-24:00 24/7.
//   • channel: V1 always 'all' (one set of hours rules everything). The column
//     exists NOW so per-channel hours (resa-only evenings, delivery lunch…) can
//     land later WITHOUT a migration ("ne pas se fermer la porte", T1.Q2).
// NOTE: Restaurant.openingHours (legacy Json, unused — nothing ever read it)
// stays untouched; THIS relational model is the source of truth.
model OpeningHour {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  dayOfWeek    Int        // 0=dimanche … 6=samedi (JS Date.getDay() convention)
  openTime     String     // "HH:mm" local Europe/Paris
  closeTime    String     // "HH:mm" ("24:00" allowed); < openTime → ends next day
  channel      String     @default("all") // V1: always 'all' (future per-channel)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

// ── Closure exceptions (Chantier horaires étape 1, additive) ──────────────────
// V1 = CLOSURES ONLY (T2.Q1): one model covers multi-day holidays, a single
// closed day, and a PARTIAL closure (startTime+endTime set → only those hours
// are closed on each covered day; both null → whole days). `type` defaults to
// 'closed'; 'special_hours' is RESERVED for future exceptional openings (Google
// Business-style) so they can land without a migration. dateStart/dateEnd are
// DATE-ONLY semantics stored at UTC midnight (inclusive range, local days).
//   • reason is PUBLIC (≤140 chars) — shown to consumers when set ("Congés
//     annuels — réouverture le 16 août", T2.Q2); empty → plain "Fermé".
model ClosureException {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  type         String     @default("closed") // 'special_hours' reserved (future)
  dateStart    DateTime   // first covered day (date-only, stored T00:00Z)
  dateEnd      DateTime   // last covered day, INCLUSIVE (date-only, T00:00Z)
  startTime    String?    // "HH:mm" — partial closure window start (with endTime)
  endTime      String?    // "HH:mm" — partial closure window end
  reason       String?    // ≤140 chars, PUBLIC (consumer-facing)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

// ── Table bill / addition (Sunday-style QR pay, brique 1) ──────────────────────
// ADDITIVE + REVERSIBLE: a "ticket" is the addition opened at a table. The waiter
// adds lines (from the menu or free), the consumer later scans the QR to PAY
// (brique 2 — not here). TicketItem FREEZES name + unitPrice at add time, so a
// later menu price change never rewrites a billed line. subtotal is recomputed on
// every write. Brand-new tables with no non-nullable FK back into existing rows →
// `db push` creates them with zero backfill; dropping them is non-destructive.
model TableTicket {
  id                String          @id @default(cuid())
  restaurantId      String
  restaurant        Restaurant      @relation(fields: [restaurantId], references: [id])
  restaurantTableId String
  restaurantTable   RestaurantTable @relation(fields: [restaurantTableId], references: [id])
  // Optional link to the table's active reservation (best-effort) so brique 2 can
  // find the deposit empreinte to release at payment. Nullable → no impact.
  reservationId     String?
  status            String          @default("open")  // open | paid | void
  currency          String          @default("eur")
  subtotal          Float           @default(0)        // Σ(unitPrice * quantity), recomputed
  openedAt          DateTime        @default(now())
  paidAt            DateTime?
  // ── Closure trace (Chantier table premium étape 1, additive) ────────────────
  // ADDITIVE + REVERSIBLE: the WHY + WHEN a ticket left the 'open' state, so a
  // closed bill is never silently lost (decision T1/T5: keep the trace, never
  // delete). closedReason is independent of `status` so we can distinguish the
  // different VOID origins (a settled empreinte vs. an empty release vs. a manual
  // cancel) and a paid close. Both nullable → existing rows stay valid, no backfill.
  //   • 'paid'        — bill settled (status='paid'; webhook owns this — optional here)
  //   • 'void_unpaid' — client left without paying (status='void', items KEPT as proof)
  //   • 'void_empty'  — empty addition released to free the table (status='void')
  //   • 'void_manual' — operator cancelled the addition (status='void')
  closedReason      String?
  closedAt          DateTime?
  // ── Bill payment (Brique 2, additive — TEST mode) ───────────────────────────
  // ADDITIVE + REVERSIBLE: the bill is paid with an AUTOMATIC-capture PaymentIntent
  // (a REAL charge, unlike the manual-capture reservation empreinte). All nullable
  // / defaulted, so existing tickets stay valid with no backfill.
  stripePaymentIntentId String?                        // the bill PaymentIntent id (pi_...)
  amountPaid        Float?                             // amount actually charged (set on payment success)
  // Grubano commission on the bill. 0 during TEST (decision: hold the rail first,
  // monetise later with Connect). The column exists now so the fee can be turned
  // on without a migration the day Connect lands.
  platformFeeAmount Float           @default(0)
  // Tip (brique pourboire — not collected yet, 0 here). Reserved, additive.
  tipAmount         Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             TicketItem[]

  @@index([restaurantId])
  @@index([restaurantTableId])
  @@index([status])
}

// ── Ledger — rail financier A3 (grand livre, APPEND-ONLY) ─────────────────────
// EVERY cent that moves writes ONE immutable line here, fed by the Stripe
// webhook (source of truth = Stripe events, not application code). RULES:
//   • APPEND-ONLY: no code may EVER update or delete a row. Any future
//     correction = a NEW compensating line (type 'adjustment') — A0 decision:
//     the ledger is THE source of truth for partner disputes.
//   • All amounts in integer CENTS (never Float — money maths must be exact).
//   • Idempotence: @@unique([sourceEventId, type]) — sourceEventId is the
//     DETERMINISTIC source id (the PaymentIntent id for payment/deposit_capture
//     lines), so a replayed webhook event OR the backfill script can never
//     create a second line for the same money movement.
// Golden equation (probe-verified by GET /api/admin/ledger/check):
//   grossAmount = applicationFeeAmount + netToRestaurant   (per line and in sum)
model LedgerEntry {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  type                  String   // payment | deposit_capture | refund | adjustment
  restaurantId          String
  ticketId              String?
  reservationId         String?
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeTransferId      String?
  grossAmount           Int                 // cents debited from the client
  applicationFeeAmount  Int      @default(0) // Grubano commission (cents)
  stripeFeeAmount       Int?                // REAL Stripe processing fee (balance transaction)
  netToRestaurant       Int                 // gross − applicationFee (cents)
  routed                Boolean  @default(false) // destination charge vs legacy platform flow
  destinationAccountId  String?             // acct_... when routed
  currency              String   @default("eur")
  // ── Channel (chantier checkout C1, additive) ────────────────────────────────
  // dinein | pickup | delivery | reservation — written by the webhook from the
  // PI's metadata.grubano_channel for ALL payments; nullable so historical lines
  // stay valid until the one-shot backfill fills them. Lets invoices and the
  // finance dashboard detail by REAL channel instead of deriving from type.
  channel               String?
  sourceEventId         String              // deterministic anti-double-count key

  @@unique([sourceEventId, type])
  @@index([restaurantId, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

// ── Payout (rail financier P4.2, Agent 38) — partner disbursement record ──────
// ADDITIVE + REVERSIBLE: a brand-new STANDALONE table (no relation added to any
// existing model → those stay byte-identical; dropping it leaves the schema
// intact). It RECORDS a disbursement to a partner — it does NOT move money. In
// P4.2 it is WRITTEN ONLY BY TESTS (starts EMPTY in prod → "versé"=0). P4.3 will
// write real rows when a transfer is executed, and stamp a companion ledger line
// of the (String, convention-only) type 'partner_transfer' (no enum migration).
//
// Beneficiary: `role` + exactly ONE of the nullable ref columns is set (keyed by
// role). Kept as bare scalar ids (NO @relation) on purpose, so no back-relation
// field is added to Creator / SupplierProfile / LogisticsProfile / Operator /
// Restaurant (they remain untouched). All amounts in integer CENTS.
model Payout {
  id                 String    @id @default(cuid())
  role               String    // creator | supplier | logistics | franchise | restaurant
  // Beneficiary reference — exactly one set, per `role` (no FK relation by design):
  creatorId          String?   // role = creator
  supplierProfileId  String?   // role = supplier
  logisticsProfileId String?   // role = logistics
  operatorId         String?   // role = franchise (the Operator holding 'franchise')
  restaurantId       String?   // role = restaurant
  amountCents        Int                          // disbursed amount (cents)
  currency           String    @default("eur")
  status             String    @default("pending") // pending | paid | failed
  paidAt             DateTime?                     // when the transfer settled
  stripeTransferId   String?                       // tr_… (set by P4.3 when executed)
  // ── P4.3 anti-double-payment lock (Agent 39) — ADDITIVE, nullable @unique ────
  // Deterministic per-cursor key (e.g. "creator:<id>:earned:<earnedCents>"): the
  // @unique makes a concurrent/re-run create for the SAME earnings cursor fail
  // (P2002) → never two Payout rows (nor two transfers) for the same balance. Also
  // reused as the Stripe Transfer idempotency key. Nullable so non-keyed rows stay
  // valid; the table is empty (P4.2) so the @unique index is risk-free.
  idempotencyKey     String?   @unique
  createdAt          DateTime  @default(now())

  @@index([role, status])
  @@index([creatorId])
  @@index([supplierProfileId])
  @@index([logisticsProfileId])
  @@index([operatorId])
  @@index([restaurantId])
}

// ── P4-Franchise-A — Franchise royalty accrued by HELD-BACK at the source ────────
// When a FRANCHISED restaurant (Order.pointOfSaleId → PointOfSale.franchiseId) is
// paid on a revenue channel, an EXTRA `rate` (6%) of the food subtotal is retained
// in the charge's application_fee ON TOP of the Grubano commission — composed at the
// orders/pay call site (lib/commission + lib/ledger UNCHANGED) — and accrued HERE as
// a 'pending' obligation owed to the franchisor. 100% pass-through: this is NOT
// Grubano revenue. Tracked SEPARATELY from LedgerEntry (the ledger records the
// composed application_fee so the golden equation gross = fee + net still holds;
// THIS table records who is owed what). NO settlement yet (= step B). Gated by
// FRANCHISE_ROYALTY_ENABLED (default OFF → fee = commission ALONE, NO row, charge
// byte-identical to today). Base = order.subtotal × rate — the SAME definition as
// franchise my-dashboard's royaltiesDue, kept consistent on purpose. No @relation
// (mirrors Payout) to keep the schema surface minimal. orderId @unique makes the
// accrual idempotent and STABLE across PI recreation (unlike paymentIntentId, which
// changes when orders/pay cancels + recreates a stale intent → would double-accrue).
model FranchiseRoyalty {
  id                   String   @id @default(cuid())
  orderId              String   @unique // idempotency key — one royalty per order
  paymentIntentId      String?           // pi_… at accrual time (recoverable from Stripe)
  franchisorOperatorId String            // = PointOfSale.franchiseId (the franchisor Operator)
  restaurantId         String            // the franchised resto that collected the sale
  pointOfSaleId        String            // the franchise POS the order was attached to
  channel              String            // pickup | delivery (revenue channel)
  baseRevenueCents     Int               // = order.subtotal in cents (consistent w/ my-dashboard)
  royaltyCents         Int               // = round(baseRevenueCents * rate) — the held-back amount
  rate                 Float             // royalty rate snapshot at accrual (0.06)
  // ── P4.5-A refund-awareness (Agent 49, ADDITIVE) ────────────────────────────
  // Cumulative royalty CENTS given back to the customer across all (partial)
  // refunds of this order — the absolute, self-healing prorata target
  // round(royaltyCents × refundedTotal / chargeTotal), capped at royaltyCents.
  // The franchise SETTLEMENT pays only the NON-refunded part (royaltyCents −
  // refundedCents); a refund AFTER settlement claws the delta back from the
  // franchisor. @default(0) ⇒ every existing row stays valid with NO backfill, and
  // the settlement is BYTE-IDENTICAL while no row has refundedCents > 0.
  refundedCents        Int      @default(0)
  status               String   @default("pending") // pending | settling | settled
  createdAt            DateTime @default(now())
  // ── P4-Franchise-B settlement (Agent 42, ADDITIVE) ──────────────────────────
  // The settlement run CLAIMS pending lines atomically into a batch: 'pending' ->
  // 'settling' + settlementId (one UPDATE), transfers the batch sum to the
  // franchisor's Connect account, then marks them 'settled' (+ payoutId, settledAt).
  // settlementId is the idempotency anchor (Stripe key = franchise:<op>:<settlementId>);
  // a line is NEVER reverted out of 'settling', so an interrupted run resumes the
  // SAME batch with the SAME key (Stripe dedupes) — never a second transfer.
  settlementId         String?  // batch id that claimed this line (set at 'settling')
  payoutId             String?  // the Payout row that disbursed this line (set at 'settled')
  settledAt            DateTime?

  @@index([franchisorOperatorId, status])
  @@index([restaurantId])
  @@index([settlementId])
}

// ── P4.5-A — Refund audit + cumulative cursor + idempotence (Agent 49) ───────────
// ADDITIVE + STANDALONE (no @relation, mirrors Payout/FranchiseRoyalty → existing
// models stay byte-identical; dropping the table leaves the schema intact). ONE row
// per executed refund of an order, written by lib/refund's executeRefund (gated by
// REFUNDS_ENABLED, default OFF → table stays empty, charge byte-identical).
//
// PRORATA decomposition recorded for audit (all server-derived from the live Stripe
// charge + the order, NEVER a client input): the customer got back `amountCents`,
// of which `restaurantReverseCents` was pulled back from the resto's Connect account
// (reverse_transfer) and `applicationFeeRefundCents` came back from Grubano's fee
// (refund_application_fee) — together exactly `amountCents`. `royaltyRefundCents` is
// the franchise-royalty slice INSIDE applicationFeeRefundCents; `royaltyClawbackCents`
// is the part of it actually reversed FROM the franchisor (only when the royalty was
// already settled — else 0, the held-back never left Grubano's balance).
//
// ANTI-DOUBLE-REFUND (payout pattern): idempotencyKey @unique = the monotone cumul
// cursor `refund:<orderId>:<alreadyRefundedCents>` (alreadyRefundedCents read from
// Stripe — the true cross-path cumul). Two concurrent attempts at the same cumul
// derive the SAME key → only one create wins (P2002) → the cumul can never be
// double-spent. The SAME key is the Stripe refund idempotency key (≤24h dedupe). A
// 'pending' row (Stripe refund issued but DB finalize failed) is RESUMED before any
// new refund. All amounts integer CENTS.
model Refund {
  id                        String   @id @default(cuid())
  orderId                   String
  restaurantId              String
  stripePaymentIntentId     String?
  stripeRefundId            String?  // re_… — set once Stripe accepted the refund
  idempotencyKey            String   @unique // refund:<orderId>:<alreadyRefundedCents>
  amountCents               Int               // refunded to the customer (this refund)
  restaurantReverseCents    Int      @default(0) // pulled back from the resto (reverse_transfer)
  applicationFeeRefundCents Int      @default(0) // came back from Grubano's fee (commission + royalty)
  royaltyRefundCents        Int      @default(0) // franchise-royalty slice inside the fee refund
  royaltyClawbackCents      Int      @default(0) // royalty actually reversed FROM the franchisor (settled case)
  franchiseRoyaltyStatus    String?           // snapshot of the royalty status at refund time (pending|settling|settled)
  reason                    String?
  status                    String   @default("pending") // pending | succeeded | failed
  createdAt                 DateTime @default(now())
  settledAt                 DateTime?

  @@index([orderId])
  @@index([restaurantId])
  @@index([status])
}

// ── P4.5-B — Chargeback / dispute lifecycle + loss reversal (Agent 51) ───────────
// ADDITIVE + STANDALONE (no @relation, mirrors Payout/Refund/FranchiseRoyalty →
// existing models stay byte-identical; dropping the table leaves the schema intact).
// ONE row per Stripe dispute, written by lib/dispute (gated by CHARGEBACKS_ENABLED,
// default OFF → table stays empty, charge byte-identical).
//
// ⚠️ DISPUTE LIABILITY REALITY (confirmed Stripe docs + code, Agent 50): GRUBANO uses
// DESTINATION charges → WITH OR WITHOUT on_behalf_of, STRIPE DEBITS GRUBANO'S PLATFORM
// BALANCE for the disputed amount + the dispute fee Φ; the resto keeps its net, the
// franchisor keeps its royalty. On a LOST dispute we UNWIND the sale (policy B-i,
// Mohammed): reverse_transfer the resto's NET (proportional to the disputed amount) +
// clawback the franchise royalty (reverse the settlement transfer if settled, else
// reduce the pending obligation via FranchiseRoyalty.refundedCents) — and crucially
// NO refund_application_fee (the fee was already swept into Stripe's principal debit;
// refunding it would OVER-credit the resto). Grubano absorbs Φ. Target arithmetic
// (full dispute): Grubano = −Φ, resto = 0, franchisor = 0, sum = 0.
//
// IDEMPOTENCE: stripeDisputeId @unique (one row, upsert on every event → order-
// independent, closed-before-created safe) + splitReversed (the loss reversal runs
// EXACTLY once) + deterministic Stripe keys (dispute-reverse:<id>, dispute-claw:<id>
// → Stripe dedupes even on a concurrent double-fire). All amounts integer CENTS.
model Dispute {
  id                   String   @id @default(cuid())
  stripeDisputeId      String   @unique // dp_…
  stripeChargeId       String?           // ch_…
  paymentIntentId      String?           // pi_…
  orderId              String?
  restaurantId         String?
  amountCents          Int      @default(0) // the DISPUTED amount (dispute.amount)
  feeCents             Int      @default(0) // the dispute fee Φ borne by Grubano (audit)
  currency             String   @default("eur")
  reason               String?            // Stripe dispute.reason
  status               String   @default("open")  // open | won | lost
  outcome              String?            // raw Stripe dispute.status snapshot
  fundsWithdrawn       Boolean  @default(false)   // Stripe provisionally pulled funds
  // ── Loss reversal (set ONCE, when the dispute is closed LOST) ────────────────
  splitReversed        Boolean  @default(false)   // the unwind ran exactly once
  reverseTransferCents Int      @default(0)        // resto NET pulled back (reverse_transfer)
  royaltyClawbackCents Int      @default(0)        // royalty reversed FROM the franchisor (settled case)
  royaltyRefundedCents Int      @default(0)        // royalty slice removed from the franchise obligation
  stripeReversalId     String?            // trr_… of the resto-net reversal (audit)
  createdAt            DateTime @default(now())
  resolvedAt           DateTime?

  @@index([orderId])
  @@index([restaurantId])
  @@index([status])
}

// ── P4.5-C1 — Customer refund claim cycle (Agent 52) ─────────────────────────────
// ADDITIVE + STANDALONE (no @relation, mirrors Refund/Dispute/Payout → existing models
// stay byte-identical; dropping the table leaves the schema intact). ONE row per
// customer claim, written by lib/claims (gated by CLAIMS_ENABLED, default OFF → table
// stays empty, no UI exposed, byte-identical).
//
// CYCLE: a consumer who OWNS a paid order, within CLAIM_WINDOW_HOURS (default 48h,
// anchored on Order.updatedAt — the delivery/last-activity time; no deliveredAt column
// exists and the status route is off-limits), files a claim (reason + optional photo +
// requested amount ≤ order total). The OWNING restaurant responds within
// CLAIM_RESPONSE_HOURS (default 24h): ACCEPT → triggers the P4.5-A engine
// (lib/refund.executeRefund) for the requested amount / REFUSE (motivated, terminal in
// C1 — contest = C2). NO restaurant response by responseDeadlineAt → AUTO-APPROVED by
// the internal cron (a resto cannot block by ignoring).
//
// MONEY: C1 does NOT compute any split — it CALLS executeRefund (royalty-aware engine).
// The real refund only happens when REFUNDS_ENABLED is ON; with CLAIMS on but REFUNDS
// off, an accepted/auto-approved claim rests at 'approved' (refundAttempted=false,
// refundId=null) — refund PENDING activation, NOT silently lost.
//
// IDEMPOTENCE: executeRefund is called AT MOST ONCE per claim — `refundAttempted`
// flips false→true via an atomic updateMany guard (count===1 winner); a double-accept /
// re-click / cron+accept race / replay never refunds twice. `activeOrderKey` (= orderId
// while active, null when terminal) is @unique → at most ONE active claim per order
// (race-safe; a terminal claim frees the order for a future C2 re-claim). CENTS = ints.
model Claim {
  id                       String   @id @default(cuid())
  orderId                  String
  consumerId               String           // Operator.id (role consumer) — the claimant
  restaurantId             String           // the owning restaurant (resolved from the order)
  reason                   String           // missing_item | wrong_order | quality | not_delivered | other
  description              String?  @db.Text // optional free-text detail
  requestedAmountCents     Int              // claimed amount (server-validated: 1 ≤ x ≤ order total cents)
  photoUrl                 String?          // optional evidence (Cloudinary, via processDishImage)
  // C1: restaurant_review | approved | refunding | refunded | refused
  // C2 (P4.5-C2, Agent 53, additive string values — NO enum migration):
  //   + arbitration   (a refused claim CONTESTED by the client, awaiting an admin)
  //   + refused_final (admin confirmed the refusal — terminal)
  status                   String   @default("restaurant_review")
  restaurantResponse       String?          // accepted | refused (what the resto chose; null if auto/none)
  restaurantResponseReason String?  @db.Text // refusal motive
  responseDeadlineAt       DateTime         // createdAt + CLAIM_RESPONSE_HOURS → auto-approve after
  decidedBy                String?          // restaurant | auto_timeout | auto_small | admin
  refundAttempted          Boolean  @default(false) // executeRefund called at most once (idempotence guard)
  refundId                 String?          // → Refund.id (set when the engine refund succeeds)
  refundError              String?  @db.Text // last refund failure (audit; refund still pending)
  // = orderId WHILE the claim is active (restaurant_review|approved|refunding|arbitration);
  // null on a terminal status (refunded|refused|refused_final). @unique ⇒ one ACTIVE claim
  // per order, race-safe (MySQL allows many NULLs), without blocking a future re-claim.
  activeOrderKey           String?  @unique
  createdAt                DateTime @default(now())
  decidedAt                DateTime?
  // ── P4.5-C2 — contest → admin arbitration (Agent 53, additive nullable) ──────
  // A REFUSED claim can be contested by the CLIENT within CLAIM_CONTEST_HOURS →
  // 'arbitration'; a NEUTRAL admin then approves (→ refund) or confirms the refusal
  // ('refused_final'). The admin is NEVER an interested party (not the resto, not the
  // client). All nullable / no default change → every existing row stays valid, no backfill.
  contestedAt              DateTime?        // when the client contested
  contestReason            String?  @db.Text // the client's contest justification
  arbitratedBy             String?          // Operator.id of the deciding admin
  arbitrationDecision      String?          // approved | refused_final
  arbitrationReason        String?  @db.Text // the admin's motive
  arbitratedAt             DateTime?

  @@index([consumerId, createdAt])
  @@index([restaurantId, status])
  @@index([status, responseDeadlineAt])
  @@index([orderId])
}

// ── Commission invoices — rail financier A4 ───────────────────────────────────
// One invoice per establishment per month, totals COMPUTED FROM LedgerEntry
// (∑ applicationFeeAmount of the period — never recomputed from rates). A0-bis:
// the levied commission is TTC; the invoice splits HT = ttc/1.20 and
// TVA 20 % = ttc − HT (cent-exact by construction). All amounts integer CENTS.
model Invoice {
  id           String   @id @default(cuid())
  restaurantId String
  periodStart  DateTime // first day of the month, 00:00 (inclusive)
  periodEnd    DateTime // first day of the NEXT month, 00:00 (exclusive)
  // LEGAL NUMBERING: continuous gapless sequence (GRB-YYYY-NNNNN). Issued from
  // InvoiceCounter inside the SAME transaction as this row — a failure rolls
  // back the counter, so numbers are never burned and never duplicated.
  number       String   @unique
  totalTtc     Int      // cents — what was actually levied over the period
  totalHt      Int      // cents — round(ttc / 1.2)
  totalTva     Int      // cents — ttc − ht (always adds back exactly)
  entriesCount Int      // ledger lines covered
  status       String   @default("issued")
  issuedAt     DateTime @default(now())
  createdAt    DateTime @default(now())

  @@unique([restaurantId, periodStart])
  @@index([restaurantId])
}

// The gapless-sequence counter behind Invoice.number — one row per year,
// incremented ONLY inside the invoice-creation transaction (never MAX+1).
model InvoiceCounter {
  year Int @id
  seq  Int @default(0)
}

model TicketItem {
  id         String      @id @default(cuid())
  ticketId   String
  ticket     TableTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Optional reference to the source dish (null for a free line). name + unitPrice
  // are FROZEN copies taken at add time — the billed line never changes if the
  // menu price changes later.
  menuItemId String?
  name       String
  unitPrice  Float
  quantity   Int         @default(1)
  // ── Premium table experience (Chantier étape 1, additive) ───────────────────
  // ADDITIVE + REVERSIBLE: all defaulted / nullable, so every existing line stays
  // valid with no backfill.
  //   • addedBy   — who put the line on the bill: 'staff' (operator) or 'client'
  //     (ordered from the app at the table). Defaults 'staff' = the legacy path.
  //   • options   — per-line modifiers (size, cooking, extras) as a JSON-encoded
  //     STRING, same SHAPE the delivery cart uses for Order.items[].options
  //     (an array of objects). MySQL has no native JSON column reuse here → @db.Text.
  //   • notes     — free customer/staff note for this line ("sans oignons").
  //   • allergies — per-line allergy text (the reservation-level allergies stay on
  //     Reservation; this is the line-specific extra a client may add when ordering).
  //   • status    — 'active' | 'cancelled'. The server cancels a line by SOFT-marking
  //     it 'cancelled' (kept for the trace/history) and recomputeSubtotal excludes it,
  //     instead of a hard delete (decision T3/T5: keep the trace).
  //   • cancelledAt — WHEN the line was cancelled (trace; null while active).
  addedBy    String      @default("staff")
  options    String?     @db.Text
  notes      String?
  allergies  String?
  status     String      @default("active")
  cancelledAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([ticketId])
}

model Order {
  id              String     @id @default(cuid())
  consumerId      String                          // Operator.id with role=consumer
  restaurantId    String
  restaurant      Restaurant @relation(fields: [restaurantId], references: [id])
  items           Json                            // [{ itemId, name, qty, price, options }]
  subtotal        Float
  deliveryFee     Float      @default(1.99)
  total           Float
  status          String     @default("received") // received|preparing|ready|picked_up|delivered|cancelled
  fulfillmentType String     @default("delivery") // delivery|pickup
  deliveryAddress String
  paymentMethod   String     @default("card")
  // ── Checkout payment (chantier C1, additive — TEST mode) ────────────────────
  // ADDITIVE + REVERSIBLE: pickup/delivery orders are now REALLY charged (C0:
  // immediate payment at order). The PI is an automatic-capture destination
  // charge when the resto's Connect account is active (commission on the PRODUCT
  // subtotal, delivery fee 100 % to the resto). paymentStatus: null = legacy /
  // not initiated, 'pending' = PI created, 'paid' = webhook-confirmed.
  stripePaymentIntentId String? @unique
  paymentStatus   String?
  pointsEarned    Int        @default(0)
  estimatedTime   Int        @default(30)
  trackingUrl     String?
  // Optional location attribution (set when a franchise operator's POS
  // generated the order — used for consolidated multi-location reporting).
  pointOfSaleId   String?
  pointOfSale     PointOfSale? @relation(fields: [pointOfSaleId], references: [id])
  // Referral code captured at checkout (cookie or manual entry). Plain string
  // — kept independent of the Referral row so reporting still works even if
  // the Referral expires before this row is touched. The matching
  // ReferralOrder row (if any) is created server-side at order time.
  referralCode    String?
  // ── Promotions restaurateur (P1, additive) ──────────────────────────────────
  // The promo APPLIED to this order (server-resolved at checkout, D4 — the
  // client never sends a discount) and the discount amount in EUR. The resto
  // finances its promo (D1): the customer pays total = subtotal − discount +
  // fee, and the commission base follows COMMISSION_BASE (D2). Both written
  // BEST-EFFORT post-create (column-tolerant until the db push).
  promotionId     String?
  discount        Float      @default(0)
  // ── Loyalty redemption (chantier fidélité L1, additive) ─────────────────────
  // Points spent on this order + the EUR credit applied, in CENTS. Grubano
  // FINANCES the credit (D1): it reduces the NET application_fee, never the
  // resto's net nor the commission base. Debited at the confirmed payment
  // (webhook, D6) and re-credited on refund. Written BEST-EFFORT post-create
  // (column-tolerant until the db push → loyalty is inert before the push).
  pointsRedeemed     Int  @default(0)
  loyaltyCreditCents Int  @default(0)
  // ── Small-order fee (V1.5, additive) ────────────────────────────────────────
  // Flat fee added when the items subtotal is BELOW a threshold (env
  // SMALL_ORDER_FEE_CENTS / SMALL_ORDER_THRESHOLD_CENTS). Paid by the CLIENT,
  // kept 100 % by GRUBANO (added to the application_fee) — NEVER touched by the
  // resto, the commission base, the chef royalty, the loyalty credit or promos.
  // In CENTS. Written BEST-EFFORT post-create (column-tolerant until the db push
  // → the fee is inert before the push).
  smallOrderFeeCents Int  @default(0)
  referralOrder   ReferralOrder?
  // Inverse side of DishSale.order (brique 3A, ADDITIVE) — creator-recipe sales
  // attributed to this order. Nullable list, no impact on existing orders.
  dishSales       DishSale[]
  // ── Chef contribution tracking (Mission 1 Creator Studio, ADDITIVE) ─────────
  // The creator (chef) page slug the buyer came through (grubano_chef cookie,
  // 24 h last-touch). A pure STAT — no financial impact, never feeds the
  // affiliation rail (that's grubano_ref / ReferralOrder, influencer role).
  // Nullable → zero backfill, existing rows untouched.
  chefSlug        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([pointOfSaleId])
  @@index([referralCode])
  @@index([promotionId])
  @@index([chefSlug])
}

// ── Franchise multi-location ──────────────────────────────────────────────────

// A franchise operator (Operator.role = "franchise") owns one or more
// physical or virtual locations. Each location can be attributed independently
// in orders + analytics. Coordinates are geocoded via lib/geocode.ts (BAN)
// at create/update time, same pattern as Restaurant.
model PointOfSale {
  id          String   @id @default(cuid())
  franchiseId String
  franchise   Operator @relation(fields: [franchiseId], references: [id])
  name        String
  address     String?
  city        String?
  lat         Float?
  lng         Float?
  // Legacy free-text brand label — KEPT for backward compatibility (brique 2A).
  // The real link is brandId/brand_ref below; this text column will be removed
  // in a later brique (2C) once all rows are migrated.
  brand       String?  // which Grubano brand this POS operates (free-form, legacy)
  // ── Real link to a franchisable Brand (brique 2A, ADDITIVE) ──────────────────
  // Nullable so existing PointOfSale rows stay valid until they are linked.
  brandId     String?
  brand_ref   Brand?   @relation(fields: [brandId], references: [id])
  isActive    Boolean  @default(true)
  orders      Order[]
  // Inverse side of Restaurant.pointOfSale (B2) — the franchised restaurant this POS
  // maps to (1:1). Zero extra column on PointOfSale.
  restaurant  Restaurant? @relation("RestaurantPointOfSale")
  createdAt   DateTime @default(now())

  @@index([franchiseId])
  @@index([brandId])
}

// ── Creator referral programme (CONFIGURABLE) ─────────────────────────────────
// All commercial parameters live in ReferralConfig (single global row) so
// Mohammed can tune them from a future /dashboard/referral settings page
// without a code change. Defaults match the values Mohammed approved at
// programme launch.
model ReferralConfig {
  id                        String  @id @default(cuid())
  // Creator's cut of GRUBANO'S commission on a referred order (NOT of basket).
  // B0 (11 June 2026): 30 % of Grubano's REAL fee — the creator is paid from
  // Grubano's share, never a surcharge on the resto.
  commissionPctOfGrubanoFee Float   @default(0.30)
  // B0-quater (11 June, evening): the creator is paid in PERCENTAGES ONLY — the
  // fixed 5 € acquisition bonus is REMOVED. 0 = no bonus is ever written (the
  // default); Mohammed can re-activate a bonus by setting an amount here.
  newCustomerBonusAmount    Float   @default(0)
  // How long the creator earns on a referred customer's orders, from
  // the referral start date.
  durationDays              Int     @default(90)
  // Welcome discount on the referred customer's first order.
  customerDiscountPct       Float   @default(0.10)
  customerDiscountCapEur    Float   @default(5)
  active                    Boolean @default(true)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

// A live referral binding: customer ↔ creator, with an expiry computed at
// creation time from ReferralConfig.durationDays. We freeze expiresAt rather
// than recomputing from config on read, so future config tweaks never
// retroactively shorten an existing referral window.
model Referral {
  id         String         @id @default(cuid())
  creatorId  String
  creator    Creator        @relation(fields: [creatorId], references: [id])
  // customerId is an Operator.id with role=consumer. Kept as a plain string
  // (same convention as Order.consumerId) to avoid a second relation back
  // into Operator and keep this migration purely additive on existing models.
  customerId String
  codeUsed   String
  startedAt  DateTime       @default(now())
  expiresAt  DateTime
  active     Boolean        @default(true)
  orders     ReferralOrder[]
  createdAt  DateTime       @default(now())

  @@index([creatorId])
  @@index([customerId])
  @@index([codeUsed])
}

// One row per qualifying order routed through a referral. `creatorEarning`
// is FROZEN at order time (commissionPctOfGrubanoFee × grubanoFee) so future
// config changes can't retroactively rewrite past payouts.
model ReferralOrder {
  id             String   @id @default(cuid())
  referralId     String
  referral       Referral @relation(fields: [referralId], references: [id])
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id])
  grubanoFee     Float    // Grubano's REAL commission on this order (lib/commission), captured at order time
  creatorEarning Float    // grubanoFee × commissionPctOfGrubanoFee (B0: 30 %) — FROZEN
  // Acquisition bonus trace (B0-quater: amount comes from ReferralConfig.
  // newCustomerBonusAmount, default 0 = never written). Separate column so the
  // trace stays auditable (earning = flow share, bonus = acquisition).
  newCustomerBonus Float  @default(0)
  // ── Earnings engine (B2a, additive) ─────────────────────────────────────────
  // pending → matured (7 days after the ORDER + order paid + not fully refunded
  // + not self-referral) → paid (B2b payouts). cancelled = never-paid order /
  // fully refunded / self-referral, with the reason logged by the maturation
  // run. ADD COLUMN NOT NULL DEFAULT 'pending' backfills existing rows.
  status         String   @default("pending") // pending | matured | cancelled | paid
  maturedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([referralId])
}

// ── Creator-recipe adoption mechanic (brique 3A) ──────────────────────────────
// ADDITIVE + REVERSIBLE: these three models are brand-new tables with no FK back
// onto existing rows that isn't nullable, so `db push` creates them with zero
// backfill and dropping them again leaves the rest of the schema untouched.
//
// Business rule (frozen at adoption time, see DishSale):
//   • A restaurateur (Brand) adopts an approved CreatorDish and puts it on its
//     menu (optional MenuItem link). It commits to keep it ≥ minCommitmentDays.
//   • While the recipe is on the menu, the creator earns `creatorCommissionPct`
//     (default 4 %) of every sale of that dish. Grubano takes `grubanoCutPct`
//     (default 20 %) of that creator payout.
//   • `successThresholdEur` of generated revenue marks the adoption as "working"
//     and underpins the anti-circumvention / early-exit settlement logic.
// All commercial parameters live in AdoptionConfig (single global row) so they
// can be tuned from the back office without a code change. Per-sale amounts are
// FROZEN on the DishSale row, never recomputed from config on read.

model DishAdoption {
  id                  String      @id @default(cuid())
  creatorDishId       String
  creatorDish         CreatorDish @relation(fields: [creatorDishId], references: [id])
  brandId             String
  brand               Brand       @relation(fields: [brandId], references: [id])
  // Optional menu entry created for this adoption (a Brand may adopt a recipe
  // before wiring up the concrete MenuItem). Nullable → no impact on MenuItem.
  menuItemId          String?
  menuItem            MenuItem?   @relation(fields: [menuItemId], references: [id])
  adoptedAt           DateTime    @default(now())
  minCommitmentDays   Int         @default(60)
  sellingPrice        Float
  status              String      @default("active") // active | ended
  endedAt             DateTime?
  earlyExitSettlement Float?      // settlement owed if ended before commitment
  createdAt           DateTime    @default(now())
  sales               DishSale[]

  @@index([creatorDishId])
  @@index([brandId])
  @@index([status])
}

// ── City-exclusive recipes (levier 3A) ────────────────────────────────────────
// Queue of brands waiting to adopt a recipe in a city that is already taken by
// another restaurant (first-come exclusivity). The runtime waitlist mechanics
// (offer / accept / expire) land in brique B — this model only stores the queue.
model AdoptionWaitlist {
  id             String      @id @default(cuid())
  creatorDishId  String
  creatorDish    CreatorDish @relation(fields: [creatorDishId], references: [id])
  brandId        String
  brand          Brand       @relation(fields: [brandId], references: [id])
  city           String
  status         String      @default("waiting") // waiting | offered | accepted | declined | expired | cancelled
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  createdAt      DateTime    @default(now())

  @@index([creatorDishId, city, status])
  @@index([brandId])
}

model DishSale {
  id             String       @id @default(cuid())
  adoptionId     String
  adoption       DishAdoption @relation(fields: [adoptionId], references: [id])
  // Optional link to the consumer Order that generated this sale (nullable so a
  // sale can be recorded from POS/aggregate flows without an Order row).
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id])
  amount         Float        // sale amount in €
  creatorEarning Float        // FROZEN = amount × rateApplied
  grubanoCut     Float        // FROZEN = creatorEarning × grubanoCutPct (0.20)
  // Levier 1: the creator commission rate actually used for this sale, frozen at
  // order time (0.04 = recipe creator's own traffic, 0.01 = organic/other).
  // Nullable so legacy rows written before levier 1 stay valid.
  rateApplied    Float?
  // ── Earnings engine (B2a, additive) — same lifecycle as ReferralOrder ───────
  status         String       @default("pending") // pending | matured | cancelled | paid
  maturedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([adoptionId])
  @@index([createdAt])
}

model AdoptionConfig {
  id                   String   @id @default(cuid())
  minCommitmentDays    Int      @default(60)
  successThresholdEur  Float    @default(300)
  // LEGACY, NON LU (hygiène pré-live) — plus aucun lecteur dans le code ;
  // conservé au schema (migration destructive interdite). La config vivante est
  // creatorCommissionPctReferred/Organic ci-dessous.
  creatorCommissionPct Float    @default(0.04)
  // ── B0 (11 June 2026): adopted-recipe royalty = FLAT 2 % of the dish price,
  // paid FROM Grubano's share (no Grubano cut on it, no two-tier traffic split).
  // The levier-1 two-rate plumbing is KEPT (parameterisable) — B0 simply sets
  // both tiers to 0.02 and the cut to 0. Existing rows: UPDATE in the C1 db
  // push sequence.
  creatorCommissionPctReferred Float @default(0.02)
  creatorCommissionPctOrganic  Float @default(0.02)
  grubanoCutPct        Float    @default(0)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// ── LlmUsage (LLM cost-governance metering — gateway step 1, Agent 14) ─────────
// One row PER LLM call routed through lib/llm (the single gateway). Pure metering
// for visibility + to seed step-2 per-partner quotas; it gates NOTHING and touches
// NO money. ADDITIVE + REVERSIBLE: a brand-new table; dropping it leaves the schema
// intact. estimatedCostCents is an ESTIMATE (Float) from configurable placeholder
// rates — it is NOT real money (no Stripe/ledger involvement). operatorId is a free
// string (nullable) — not all calls are operator-scoped, and step-1 does not yet
// thread it everywhere; no FK so a metering row never blocks/owns an Operator.
model LlmUsage {
  id                 String   @id @default(cuid())
  task               String                  // LlmTask (creator_vetting, dish_scan, …)
  model              String                  // resolved model id (claude-haiku-4-5, …)
  inputTokens        Int      @default(0)
  outputTokens       Int      @default(0)
  estimatedCostCents Float    @default(0)     // estimate via configurable placeholder rates
  operatorId         String?                  // optional attribution (nullable; no FK)
  createdAt          DateTime @default(now())

  @@index([task])
  @@index([createdAt])
}
