# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Database ──────────────────────────────────────────────────────────────────
# o2switch MySQL (local dev: use your local MySQL or a tunnel)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# ── AI / APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
BREVO_API_KEY="REPLACE_ME"

# ── Cloudinary (dish photos — server-signed upload only, NEVER exposed client) ──
# Used by app/api/menu/photo to store moderated dish photos. The API secret is
# read server-side only to sign the upload; it must never reach the browser.
CLOUDINARY_CLOUD_NAME="REPLACE_ME"
CLOUDINARY_API_KEY="REPLACE_ME"
CLOUDINARY_API_SECRET="REPLACE_ME"
# YouTube Data API v3 key (restrict it to the YouTube Data API in GCP).
# Used by lib/youtube.ts for creator subscriber counts. Optional: when unset,
# the helpers return null gracefully and nothing breaks.
YOUTUBE_API_KEY="REPLACE_ME"

# ── Payments — Stripe (TEST mode) ─────────────────────────────────────────────
# Reservation deposit empreinte (manual-capture PaymentIntent). The SECRET key is
# read server-side only (lib/stripe.ts) and NEVER exposed to the client — only the
# PaymentIntent client_secret + the publishable key (safe to expose) reach the front.
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
# Webhook signing secret (whsec_...) from the Stripe dashboard webhook endpoint.
# Used by app/api/webhooks/stripe to VERIFY each event's signature — the only thing
# that authenticates the call, since the webhook route is public. Without it the
# route returns 500 (events are retried by Stripe, never silently dropped).
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
# Signing secret of the SECOND webhook endpoint scoped to "Connected accounts"
# (Stripe Connect — account.updated events). Connect events are signed with the
# Connect endpoint's OWN secret, different from the one above; the route tries
# both. Optional until Connect onboarding (rail financier A1) is used.
STRIPE_CONNECT_WEBHOOK_SECRET="whsec_REPLACE_ME"

# ── Invoicing — Grubano legal identity (rail A4) ─────────────────────────────
# Printed on the monthly commission invoices (émetteur). Until configured, the
# invoices show explicit "[... à configurer]" placeholders — impossible to
# mistake for real values. Fill before issuing any REAL invoice.
GRUBANO_LEGAL_NAME="REPLACE_ME (raison sociale)"
GRUBANO_LEGAL_ADDRESS="REPLACE_ME (adresse du siège)"
GRUBANO_SIREN="REPLACE_ME"
GRUBANO_VAT_NUMBER="REPLACE_ME (FRxx...)"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="REPLACE_WITH_32_BYTE_HEX"
NEXTAUTH_URL="http://localhost:3000"

# ── Cron / machine probes (rail A6 — gardiens) ───────────────────────────────
# Shared secret consumed by /api/admin/ledger/check AND
# /api/admin/invoices/generate via the X-Internal-Token header. When set and
# matching, the cron scripts (scripts/cron/*.js) bypass the session gate.
# When EMPTY/UNSET, both routes fall back to operator-session auth ONLY — there
# is no accidental open-to-the-world mode. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_CRON_TOKEN="REPLACE_WITH_32_BYTE_HEX"

# Destination of the daily ledger-alert mail (when the check returns ok:false)
# AND the monthly invoice recap mail. Reuses the existing SMTP_* transport.
ALERT_EMAIL="ops@grubano.com"

# Base URL the cron scripts hit (defaults to https://www.grubano.com if unset).
# Override on staging if the cron probes the staging instance instead of prod.
SITE_URL="https://www.grubano.com"

# ── Réclamations (claims) — auto-résolution FAIL-SAFE (P0-27, vague 1) ───────
# Principe fondateur : AUCUN remboursement sans validation humaine. L'auto-
# résolution des petites réclamations (decidedBy 'auto_small') est verrouillée
# par DEUX variables ; sans les DEUX explicitement posées, elle est INOPÉRANTE.
#
# Verrou n°1 — kill-switch booléen. Seule la chaîne exacte 'true' active
# (défaut OFF). Exige CLAIMS_ENABLED (vérifié par `npm run check:flags`).
# ⛔ HORS PILOTE — ne pas activer pendant la bêta.
CLAIM_AUTO_RESOLVE_ENABLED=""
# Verrou n°2 — plafond d'auto-résolution en CENTIMES (ex. "1000" = 10 €).
# Absent, vide, non-numérique ou négatif → 0 = désactivé (fail-safe : une
# valeur mal formée ne réactive JAMAIS l'auto-remboursement, tracé en console).
# Ne sert que si CLAIM_AUTO_RESOLVE_ENABLED='true'.
CLAIM_AUTO_APPROVE_MAX_CENTS=""

# ── Captures punitives (V4-1, vague 4) — décision fondateur, motif JURIDIQUE ──
# Débiter une carte à titre de SANCTION (pénalité no-show, walk-out impayé)
# exige une base contractuelle que le pilote n'a pas. La capture punitive est
# INOPÉRANTE par défaut : no-show ⇒ l'empreinte est LIBÉRÉE (la garantie n'est
# pas exercée) ; la route /deposit/capture et le choix « capture » du close
# refusent (403 tracé). L'EMPREINTE (pré-autorisation + libération) fonctionne
# normalement. Seule la chaîne exacte 'true' réactive (post-pilote, avec base
# contractuelle). ⛔ HORS PILOTE.
PUNITIVE_CAPTURE_ENABLED=""

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
