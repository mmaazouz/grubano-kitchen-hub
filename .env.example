# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ── Database ──────────────────────────────────────────────────────────────────
# o2switch MySQL (local dev: use your local MySQL or a tunnel)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME"

# ── AI / APIs ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-REPLACE_ME"
BREVO_API_KEY="REPLACE_ME"
# YouTube Data API v3 key (restrict it to the YouTube Data API in GCP).
# Used by lib/youtube.ts for creator subscriber counts. Optional: when unset,
# the helpers return null gracefully and nothing breaks.
YOUTUBE_API_KEY="REPLACE_ME"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="REPLACE_WITH_32_BYTE_HEX"
NEXTAUTH_URL="http://localhost:3000"

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV="development"
